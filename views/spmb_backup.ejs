<%- include('partials/header', { title: 'Sinkronisasi SPMB' }) %>
<%- include('partials/sidebar') %>

<!-- Header & Add Button -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="bg-indigo-100 text-indigo-700 text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full border border-indigo-200">Arsip SPMB</span>
    </div>
    <h1 class="text-2xl font-extrabold text-slate-800 tracking-tight"><%= title %></h1>
    <p class="text-sm text-slate-400 font-medium mt-1">Data backup pendaftar santri dari sistem SPMB (Read-only).</p>
  </div>
  
  <div class="flex gap-2">
    <a href="/admin/import" class="bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold py-2.5 px-4 rounded-xl shadow-sm active:scale-[0.98] transition flex items-center justify-center gap-1.5 text-sm">
      <i class="bi bi-arrow-left"></i> Kembali ke Import
    </a>
  </div>
</div>

<!-- Filter Box -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-4 mb-6">
    <form action="/admin/spmb/backup" method="GET" class="flex flex-col md:flex-row gap-4">
        <div class="flex-1">
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Filter Lembaga</label>
            <select name="lembaga" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm outline-none bg-slate-50">
                <option value="">-- Semua Lembaga --</option>
                <option value="Madrasah" <%= filterLembaga === 'Madrasah' ? 'selected' : '' %>>Madrasah</option>
                <option value="PAUDQu" <%= filterLembaga === 'PAUDQu' ? 'selected' : '' %>>PAUDQu</option>
                <option value="TPQ" <%= filterLembaga === 'TPQ' ? 'selected' : '' %>>TPQ</option>
                <option value="MDT" <%= filterLembaga === 'MDT' ? 'selected' : '' %>>MDT</option>
            </select>
        </div>
        <div class="flex items-end">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-6 rounded-xl text-sm transition">Terapkan Filter</button>
        </div>
    </form>
</div>

<!-- Table -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse whitespace-nowrap">
      <thead>
        <tr class="bg-slate-50 text-[10px] font-extrabold text-slate-500 uppercase tracking-widest border-b border-slate-200">
          <th class="p-4 w-10 text-center rounded-tl-2xl">#</th>
          <th class="p-4">Nama Pendaftar</th>
          <th class="p-4">Kelas / Pendidikan</th>
          <th class="p-4">Lembaga</th>
          <th class="p-4 text-center rounded-tr-2xl">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 text-sm font-medium text-slate-600">
        <% if (santriList.length > 0) { %>
          <% santriList.forEach((s, index) => { %>
            <tr class="hover:bg-slate-50/80 transition group">
              <td class="p-4 text-center text-slate-400 font-bold text-xs"><%= index + 1 %></td>
              <td class="p-4">
                <div class="text-slate-800 font-bold"><%= s.nama %></div>
              </td>
              <td class="p-4">
                <span class="bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md text-xs font-semibold border border-slate-200">
                  <%= s.kelas %>
                </span>
              </td>
              <td class="p-4">
                <span class="bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-md text-xs font-bold border border-indigo-100">
                  <%= s.lembaga %>
                </span>
              </td>
              <td class="p-4 text-center">
                <% if (s.kelas.toLowerCase() === 'daftar ulang') { %>
                  <span class="bg-amber-100 text-amber-700 text-[10px] font-black uppercase px-2 py-0.5 rounded-full">Daftar Ulang</span>
                <% } else { %>
                  <span class="bg-emerald-100 text-emerald-700 text-[10px] font-black uppercase px-2 py-0.5 rounded-full">Baru</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="p-8 text-center text-slate-400 font-medium">
              <div class="flex flex-col items-center justify-center gap-3">
                <i class="bi bi-inbox-fill text-4xl text-slate-300"></i>
                <p>Belum ada data pendaftar yang tersedia.</p>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
