<%- include('partials/header', { title: 'Form Pengguna' }) %>
<%- include('partials/super-admin-sidebar') %>

<div class="w-full max-w-2xl mx-auto">
  <div class="mb-6 flex items-center gap-4">
    <a href="/super-admin/users" class="flex-shrink-0 w-10 h-10 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600 transition">
      <i class="bi bi-arrow-left"></i>
    </a>
    <div>
      <h1 class="text-2xl font-bold text-slate-800"><%= user ? 'Edit Akun Pengguna' : 'Tambah Akun Pengguna' %></h1>
      <p class="text-sm text-slate-500 mt-1"><%= user ? 'Perbarui informasi akun' : 'Buat akun baru untuk admin atau staf' %></p>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
    <form action="<%= user ? '/super-admin/users/edit/' + user.id : '/super-admin/users/create' %>" method="POST" enctype="multipart/form-data" class="p-6 md:p-8 space-y-6">
      
      <%- include('components/input_field', {
        id: 'nama_lengkap',
        label: 'Nama Lengkap',
        name: 'nama_lengkap',
        value: user ? user.nama_lengkap : '',
        placeholder: 'Contoh: Budi Santoso',
        required: true
      }) %>

      <%- include('components/input_field', {
        id: 'username',
        label: 'Username',
        name: 'username',
        value: user ? user.username : '',
        placeholder: 'Contoh: budi123',
        required: true
      }) %>

      <% 
        const roleOptionsHTML = `
          <option value="Super Admin" ${user && user.role === 'Super Admin' ? 'selected' : ''}>Super Admin (Sistem & Akses)</option>
          <option value="Admin" ${user && user.role === 'Admin' ? 'selected' : ''}>Admin (Akses Penuh Tagihan & Laporan)</option>
          <option value="Staf" ${(!user || (user && user.role === 'Staf')) ? 'selected' : ''}>Staf (Akses Input Data)</option>
        `;
      %>
      <%- include('components/select_field', {
        id: 'role',
        label: 'Role',
        name: 'role',
        required: true,
        optionsHTML: roleOptionsHTML
      }) %>

      <hr class="border-slate-100">

      <%- include('components/input_field', {
        id: 'password',
        label: `Password ${user ? '(Isi hanya jika ingin mengganti)' : ''}`,
        name: 'password',
        type: 'password',
        placeholder: user ? 'Biarkan kosong jika tidak diubah' : 'Minimal 6 karakter',
        required: user ? false : true
      }) %>

      <hr class="border-slate-100">

      <div>
        <label for="ttdImage" class="block text-sm font-semibold text-slate-700 mb-1.5">Tanda Tangan (Opsional)</label>
        <% if (user && user.ttdPath) { %>
          <div class="mb-3">
            <p class="text-xs text-slate-500 mb-1">Tanda tangan saat ini:</p>
            <img src="<%= user.ttdPath %>" alt="TTD" class="h-12 object-contain border border-slate-200 rounded p-1 bg-slate-50">
          </div>
        <% } %>
        <input type="file" id="ttdImage" name="ttdImage" accept="image/*" class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 transition">
        <p class="text-xs text-slate-500 mt-2">Upload gambar tanda tangan (PNG/JPG/WebP). Gambar ini akan muncul secara otomatis di Kwitansi pembayaran yang diinput oleh akun ini.</p>
      </div>

      <%- include('components/form_actions', {
        backUrl: '/super-admin/users',
        submitText: '<i class="bi bi-save mr-1"></i> Simpan'
      }) %>
      
    </form>
  </div>
</div>

<%- include('partials/footer') %>
