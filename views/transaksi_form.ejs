<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<%- include('components/page_header', { 
  title: 'Input Transaksi Keuangan', 
  subtitle: 'Catat pemasukan dan pengeluaran keuangan lembaga di bawah naungan madrasah.'
}) %>

<div class="max-w-5xl mx-auto space-y-8">
  
  <!-- Alerts -->
  <div class="space-y-4">
    <%- include('components/alert', { type: 'success', message: success }) %>
    <%- include('components/alert', { type: 'error', message: error }) %>
  </div>

  <!-- Main Card -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 md:p-8">
    <h2 class="text-lg font-bold text-slate-800 mb-6 flex items-center gap-2 border-b border-slate-100 pb-4">
      <i class="bi bi-pencil-square text-indigo-500"></i> Form Catat Transaksi
    </h2>

    <form action="/admin/transaksi" method="POST" id="transactionForm" class="space-y-6">
      
      <!-- Top Row: Date & Lembaga -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%- include('components/input_field', {
          id: 'tanggal',
          label: 'Tanggal Transaksi',
          name: 'tanggal',
          type: 'date',
          value: new Date().toISOString().split('T')[0],
          required: true
        }) %>

        <% 
          let lembagaGlobalOptions = '<option value="" disabled selected>-- Pilih Satuan Pendidikan --</option>';
          lembagas.forEach(l => {
            lembagaGlobalOptions += `<option value="${l.id}">${l.nama}</option>`;
          });
        %>
        <%- include('components/select_field', {
          id: 'lembagaId_global',
          label: 'Satuan Pendidikan',
          name: 'lembagaId_global',
          required: true,
          onChange: 'handleLembagaChange(this.value)',
          optionsHTML: lembagaGlobalOptions
        }) %>
      </div>

      <!-- Second Row: Jenis Transaksi -->
      <div id="row_jenis_transaksi" class="hidden">
        <%- include('components/select_field', {
          id: 'jenisTransaksi',
          label: 'Jenis Transaksi',
          name: 'jenisTransaksi',
          required: true,
          onChange: 'handleJenisTransaksiChange(this.value)',
          optionsHTML: '<option value="" disabled selected>-- Pilih Jenis Transaksi --</option>'
        }) %>
      </div>

      <!-- ==================== SECTION 1: PEMBAYARAN TAGiHAN (STUDENT) ==================== -->
      <div id="section_tagihan" class="hidden bg-slate-50/50 border border-slate-100 rounded-xl p-5 md:p-6 space-y-6">
        <h3 class="text-sm font-bold text-indigo-600 uppercase tracking-wider flex items-center gap-1.5 border-b border-slate-200/60 pb-3">
          <i class="bi bi-person-fill"></i> Detail Pembayaran Tagihan Santri
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Dropdown Kelas -->
          <%- include('components/select_field', {
            id: 'kelasId_tagihan',
            label: 'Kelas',
            name: 'kelasId_tagihan',
            onChange: 'handleKelasChange(this.value)',
            optionsHTML: '<option value="">-- Pilih Kelas --</option>'
          }) %>

          <!-- Dropdown Santri -->
          <%- include('components/select_field', {
            id: 'santriId_tagihan',
            label: 'Nama Santri',
            name: 'santriId_tagihan',
            onChange: 'handleSantriChange(this.value)',
            optionsHTML: '<option value="">-- Pilih Kelas Terlebih Dahulu --</option>'
          }) %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          <!-- Dropdown Tagihan -->
          <%- include('components/select_field', {
            id: 'tagihanId_tagihan',
            label: 'Pilih Tagihan',
            name: 'tagihanId_tagihan',
            onChange: 'handleTagihanSelectChange(this)',
            optionsHTML: '<option value="">-- Pilih Santri Terlebih Dahulu --</option>'
          }) %>

          <!-- Metode Pembayaran -->
          <%- include('components/select_field', {
            id: 'metode_tagihan',
            label: 'Metode Pembayaran',
            name: 'metode_tagihan',
            optionsHTML: `
              <option value="Cash">Cash</option>
              <option value="Transfer">Transfer</option>
            `
          }) %>
        </div>

        <!-- Catatan Tambahan -->
        <div>
          <label for="catatan_tagihan" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Catatan Tambahan (Opsional)</label>
          <textarea 
            id="catatan_tagihan" 
            name="catatan_tagihan" 
            rows="2" 
            placeholder="Keterangan tambahan..." 
            class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition duration-150"
          ></textarea>
        </div>
      </div>

      <!-- ==================== SECTION 2: PEMASUKAN LAIN (GENERAL INCOME) ==================== -->
      <div id="section_pemasukan" class="hidden bg-slate-50/50 border border-slate-100 rounded-xl p-5 md:p-6 space-y-6">
        <h3 class="text-sm font-bold text-emerald-600 uppercase tracking-wider flex items-center gap-1.5 border-b border-slate-200/60 pb-3">
          <i class="bi bi-wallet2"></i> Uraian Pemasukan (Selain Biaya Santri)
        </h3>

        <%- include('components/input_field', {
          id: 'uraianPemasukan',
          label: 'Uraian Pemasukan',
          name: 'uraianPemasukan',
          placeholder: 'Contoh: Dana Ziswaf / Bantuan Operasional'
        }) %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Diterima Dari -->
          <%- include('components/input_field', {
            id: 'diterimaDari',
            label: 'Telah Diterima Dari',
            name: 'diterimaDari',
            placeholder: 'Nama Instansi/Lembaga/Orang'
          }) %>

          <!-- Nama Pemberi -->
          <%- include('components/input_field', {
            id: 'pemberi',
            label: 'Nama Pemberi (Untuk Tanda Tangan)',
            name: 'pemberi',
            placeholder: 'Nama Lengkap Pemberi Dana'
          }) %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- This is empty space to maintain layout -->
          <div class="hidden md:block"></div>

          <!-- Metode Pembayaran -->
          <%- include('components/select_field', {
            id: 'metode_pemasukan',
            label: 'Metode Pembayaran',
            name: 'metode_pemasukan',
            optionsHTML: `
              <option value="Cash">Cash</option>
              <option value="Transfer">Transfer</option>
            `
          }) %>
        </div>

        <!-- Catatan Tambahan -->
        <div>
          <label for="catatan_pemasukan" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Catatan Tambahan (Opsional)</label>
          <textarea 
            id="catatan_pemasukan" 
            name="catatan_pemasukan" 
            rows="2" 
            placeholder="Keterangan tambahan..." 
            class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition duration-150"
          ></textarea>
        </div>
      </div>

      <!-- ==================== SECTION 3: PENGELUARAN (GENERAL EXPENSE) ==================== -->
      <div id="section_pengeluaran" class="hidden bg-slate-50/50 border border-slate-100 rounded-xl p-5 md:p-6 space-y-6">
        <h3 class="text-sm font-bold text-rose-600 uppercase tracking-wider flex items-center gap-1.5 border-b border-slate-200/60 pb-3">
          <i class="bi bi-cash-stack"></i> Rincian Pengeluaran Keuangan
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- This is empty space to maintain layout -->
          <div class="hidden md:block"></div>

          <!-- Uraian Pengeluaran -->
          <%- include('components/input_field', {
            id: 'uraianPengeluaran',
            label: 'Uraian Pengeluaran',
            name: 'uraianPengeluaran',
            placeholder: 'Contoh: Pembelian ATK / Pembayaran Listrik'
          }) %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Dibayarkan Kepada -->
          <%- include('components/input_field', {
            id: 'dibayarkanKepada',
            label: 'Dibayarkan Kepada',
            name: 'dibayarkanKepada',
            placeholder: 'Nama Penerima (Misal: Pak Budi / Toko Jaya)'
          }) %>

          <!-- Metode Pembayaran -->
          <%- include('components/select_field', {
            id: 'metode_pengeluaran',
            label: 'Metode Pembayaran',
            name: 'metode_pengeluaran',
            optionsHTML: `
              <option value="Cash">Cash</option>
              <option value="Transfer">Transfer</option>
            `
          }) %>
        </div>

        <!-- Catatan Tambahan -->
        <div>
          <label for="catatan_pengeluaran" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Catatan Tambahan (Opsional)</label>
          <textarea 
            id="catatan_pengeluaran" 
            name="catatan_pengeluaran" 
            rows="2" 
            placeholder="Keterangan tambahan..." 
            class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition duration-150"
          ></textarea>
        </div>
      </div>

      <!-- ==================== SECTION: SETOR KE MADRASAH ==================== -->
      <div id="section_setor_madrasah" class="hidden bg-slate-50/50 border border-slate-100 rounded-xl p-5 md:p-6 space-y-6">
        <h3 class="text-sm font-bold text-teal-600 uppercase tracking-wider flex items-center gap-1.5 border-b border-slate-200/60 pb-3">
          <i class="bi bi-bank"></i> Setoran Ke Kas Madrasah
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Uraian Setoran -->
          <%- include('components/input_field', {
            id: 'uraian_setoran',
            label: 'Uraian Setoran',
            name: 'uraian_setoran',
            value: 'Setoran Rutin ke Madrasah',
            placeholder: 'Contoh: Setoran 10% Bulan Juli'
          }) %>

          <!-- Metode Pembayaran -->
          <%- include('components/select_field', {
            id: 'metode_setoran',
            label: 'Metode Pembayaran',
            name: 'metode_setoran',
            optionsHTML: `
              <option value="Cash">Cash</option>
              <option value="Transfer">Transfer</option>
            `
          }) %>
        </div>

        <!-- Catatan Tambahan -->
        <div>
          <label for="catatan_setoran" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Catatan Tambahan (Opsional)</label>
          <textarea 
            id="catatan_setoran" 
            name="catatan_setoran" 
            rows="2" 
            placeholder="Keterangan tambahan setoran..." 
            class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition duration-150"
          ></textarea>
        </div>
      </div>

      <!-- ==================== SECTION 4: TABUNGAN (STUDENT SAVINGS) ==================== -->
      <div id="section_tabungan" class="hidden bg-slate-50/50 border border-slate-100 rounded-xl p-5 md:p-6 space-y-6">
        <h3 class="text-sm font-bold text-indigo-600 uppercase tracking-wider flex items-center gap-1.5 border-b border-slate-200/60 pb-3">
          <i class="bi bi-piggy-bank-fill"></i> Detail Transaksi Tabungan Santri
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Dropdown Kelas -->
          <%- include('components/select_field', {
            id: 'kelasId_tabungan',
            label: 'Kelas',
            name: 'kelasId_tabungan',
            onChange: 'handleKelasChangeTabungan(this.value)',
            optionsHTML: '<option value="">-- Pilih Kelas --</option>'
          }) %>
          <div class="hidden md:block"></div>
        </div>
        
        <!-- List Santri untuk Bulk Input Tabungan -->
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Daftar Santri (Isi Nominal Tabungan)</label>
          <div id="santri_list_tabungan" class="w-full bg-white border border-slate-200 rounded-xl p-4 shadow-sm text-sm text-slate-500">
            Pilih kelas terlebih dahulu untuk melihat daftar santri.
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Metode Pembayaran -->
          <%- include('components/select_field', {
            id: 'metode_tabungan',
            label: 'Metode Transaksi',
            name: 'metode_tabungan',
            optionsHTML: `
              <option value="Cash">Cash</option>
              <option value="Transfer">Transfer</option>
            `
          }) %>
          <div class="hidden md:block"></div>
        </div>
 
        <!-- Catatan Tambahan -->
        <div>
          <label for="catatan_tabungan" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Catatan Tambahan (Opsional)</label>
          <textarea 
            id="catatan_tabungan" 
            name="catatan_tabungan" 
            rows="2" 
            placeholder="Keterangan tambahan..." 
            class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition duration-150"
          ></textarea>
        </div>
      </div>

      <!-- ==================== SECTION 5: INFAK HARIAN (DAILY ALMS) ==================== -->
      <div id="section_infak" class="hidden bg-slate-50/50 border border-slate-100 rounded-xl p-5 md:p-6 space-y-6">
        <h3 class="text-sm font-bold text-amber-600 uppercase tracking-wider flex items-center gap-1.5 border-b border-slate-200/60 pb-3">
          <i class="bi bi-heart-fill"></i> Detail Pencatatan Infak Harian
        </h3>
        
        <div>
          <label for="catatan_infak" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Catatan / Uraian Infak (Opsional)</label>
          <textarea 
            id="catatan_infak" 
            name="catatan_infak" 
            rows="2" 
            placeholder="Catatan tambahan (Contoh: Infak jumat berkah)..." 
            class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition duration-150"
          ></textarea>
        </div>
      </div>

      <!-- ==================== COMMON ROW: NOMINAL (ONLY SHOWS WHEN SECTION IS ACTIVE) ==================== -->
      <div id="row_nominal" class="hidden grid grid-cols-1 md:grid-cols-2 gap-6 items-end">
        <div id="global_nominal_wrapper">
          <label for="nominal" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Jumlah Nominal (Rp) *</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-sm font-semibold text-slate-400">Rp</span>
            <input 
              type="number" 
              min="1" 
              id="nominal" 
              name="nominal" 
              required 
              placeholder="0" 
              class="w-full border border-slate-200 rounded-xl pl-11 pr-4 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition duration-150 font-semibold text-slate-800"
            >
          </div>
        </div>
        
        <div id="submit_btn_wrapper">
          <button 
            type="submit" 
            class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3 px-4 rounded-xl shadow-lg hover:shadow-emerald-500/20 active:scale-[0.98] transition duration-150 flex items-center justify-center gap-1.5"
          >
            <i class="bi bi-save-fill"></i> Simpan Transaksi
          </button>
        </div>
      </div>

    </form>
  </div>

  <!-- Recent Transactions Card -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="p-6 border-b border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
        <i class="bi bi-clock-history text-indigo-500"></i> Transaksi Terbaru (10 Terakhir)
      </h2>
      <a href="/admin/laporan" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800 flex items-center gap-1">
        Lihat Semua Laporan <i class="bi bi-arrow-right"></i>
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100 text-slate-500 text-xs font-bold uppercase tracking-wider">
            <th class="py-4 px-6 filterable" data-column="tanggal">Tanggal</th>
            <th class="py-4 px-6">No. Kwitansi</th>
            <th class="py-4 px-6 filterable" data-column="lembaga" data-options="<%= filterOptions.lembaga.join(',') %>">Lembaga</th>
            <th class="py-4 px-6 filterable" data-column="santri" data-options="<%= filterOptions.santri.join(',') %>">Uraian / Nama Santri</th>
            <th class="py-4 px-6 filterable" data-column="jenis" data-options="Pemasukan,Pengeluaran">Jenis</th>
            <th class="py-4 px-6 filterable" data-column="nominal">Nominal</th>
            <th class="py-4 px-6">Metode</th>
            <th class="py-4 px-6 filterable" data-column="operator">Operator</th>
            <th class="py-4 px-6 text-center">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm text-slate-600">
          <% if (transactions.length === 0) { %>
            <tr>
              <td colspan="8" class="py-12 text-center text-slate-500">
                <i class="bi bi-inbox text-4xl text-slate-300 mb-3 block"></i>Belum ada transaksi tercatat.
              </td>
            </tr>
          <% } else { %>
            <% 
              // Helper fungsi slug lembaga
              const getSlug = (lembagaName) => {
                const name = lembagaName.toLowerCase();
                if (name.includes('madrasah')) return 'mjic';
                if (name.includes('paudqu')) return 'paudqu';
                if (name.includes('tpq')) return 'tpq';
                if (name.includes('mdt')) return 'mdt';
                return 'mjic';
              };
            %>
            <% transactions.forEach(t => { %>
              <tr class="hover:bg-slate-50/50 transition duration-150">
                <td class="py-4 px-6 font-medium text-slate-500">
                  <%= new Date(t.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </td>
                <td class="py-4 px-6 text-xs font-mono text-slate-600">
                  <%= t.nomor_kwitansi || '-' %>
                </td>
                <td class="py-4 px-6">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-800">
                    <%= t.lembaga.nama %>
                  </span>
                </td>
                <td class="py-4 px-6 font-medium text-slate-800">
                  <% if (t.santri) { %>
                    <div class="font-bold"><%= t.santri.nama %></div>
                    <div class="text-xs text-slate-400"><%= t.kelas ? t.kelas.nama : '' %></div>
                  <% } else { %>
                    <% 
                      // Extract Uraian from Keterangan text
                      const lines = t.keterangan ? t.keterangan.split('\n') : [];
                      const uraianLine = lines.find(l => l.startsWith('Uraian:'));
                      const cleanUraian = uraianLine ? uraianLine.replace('Uraian:', '').trim() : t.keterangan;
                    %>
                    <%= cleanUraian || '-' %>
                  <% } %>
                </td>
                <td class="py-4 px-6">
                  <% if (t.jenis === 'Pemasukan') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Pemasukan
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Pengeluaran
                    </span>
                  <% } %>
                </td>
                <td class="py-4 px-6 font-bold text-slate-900">
                  Rp <%= Number(t.nominal).toLocaleString('id-ID') %>
                </td>
                <td class="py-4 px-6">
                  <% 
                    const lines = t.keterangan ? t.keterangan.split('\n') : [];
                    const metodeLine = lines.find(l => l.startsWith('Metode:'));
                    const metodeVal = metodeLine ? metodeLine.replace('Metode:', '').trim() : 'Cash';
                  %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold <%= metodeVal === 'Transfer' ? 'bg-sky-50 text-sky-700 border border-sky-100' : 'bg-amber-50 text-amber-700 border border-amber-100' %>">
                    <%= metodeVal %>
                  </span>
                </td>
                <td class="py-4 px-6 text-xs font-semibold text-slate-700">
                  <div class="flex items-center gap-1.5">
                    <div class="w-6 h-6 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-[10px] font-bold text-slate-500 uppercase">
                      <%= (t.user && t.user.nama_lengkap) ? t.user.nama_lengkap.substring(0, 2) : 'OP' %>
                    </div>
                    <%= (t.user && t.user.nama_lengkap) ? t.user.nama_lengkap : 'Operator' %>
                  </div>
                </td>
                <td class="py-4 px-6 text-center flex items-center justify-center gap-1.5">
                  <% if (t.jenis === 'Pemasukan') { %>
                    <button 
                      type="button"
                      onclick="toggleKwitansiPreview(this, '/admin/lembaga/<%= getSlug(t.lembaga.nama) %>/kwitansi/<%= t.id %>?preview=1', 10)"
                      class="inline-flex items-center justify-center p-1.5 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-100 transition shadow-sm"
                      title="Preview Kwitansi"
                    >
                      <i class="bi bi-printer-fill text-sm"></i>
                    </button>
                  <% } %>
                  <a 
                    href="/admin/transaksi/edit/<%= t.id %>?redirectUrl=/admin/transaksi/baru" 
                    class="text-indigo-500 hover:text-indigo-700 p-1.5 rounded-lg hover:bg-indigo-50 transition duration-150"
                    title="Edit Transaksi"
                  >
                    <i class="bi bi-pencil-fill text-sm"></i>
                  </a>
                  <form action="/admin/transaksi/delete/<%= t.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data transaksi ini?');" class="inline">
                    <input type="hidden" name="redirectUrl" value="/admin/transaksi/baru">
                    <button type="submit" class="text-rose-500 hover:text-rose-700 p-1.5 rounded-lg hover:bg-rose-50 transition duration-150" title="Hapus Transaksi">
                      <i class="bi bi-trash3-fill text-sm"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script>
  window.allTagihans = <%- JSON.stringify(tagihans) %>;
</script>
<script src="/js/transaksi-form.js?v=<%= Date.now() %>"></script>

<script src="/js/table-filter.js"></script>
<script src="/js/preview_kwitansi.js"></script>
<%- include('partials/footer') %>
