<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<%- include('components/page_header', { 
  title: title, 
  subtitle: `Kelola data santri aktif untuk lembaga ${lembaga.nama}.`,
  actionHtml: `<a href="/import" class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold rounded-xl text-xs transition duration-150"><i class="bi bi-database-fill-down"></i> Tarik Data (SPMB)</a>`
}) %>

<!-- Table Container -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
  <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2">
        <i class="bi bi-people-fill text-indigo-500 text-lg"></i>
        <h3 class="font-bold text-slate-700">Daftar Santri</h3>
      </div>
      <span class="text-xs font-bold text-slate-400 bg-slate-100 px-3 py-1 rounded-full"><%= totalItems %> Santri</span>
    </div>
    
    <form action="" method="GET" class="relative w-full md:w-64">
      <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Cari nama santri..." class="w-full pl-10 pr-4 py-2 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all">
      <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
    </form>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-100 text-xs font-bold text-slate-400 uppercase tracking-wider">
          <th class="p-4 pl-6 w-16 text-center">No</th>
          <th class="p-4 filterable" data-column="nama" data-options="">Nama Santri</th>
          <th class="p-4 filterable" data-column="kelas" data-options="<%= filterOptions.kelas.join(',') %>">Kelas</th>
          <th class="p-4 filterable" data-column="lembaga" data-options="<%= filterOptions.lembaga.join(',') %>">Lembaga</th>
          <th class="p-4 text-center">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 text-sm font-medium text-slate-600">
        <% if (santriList.length === 0) { %>
          <%- include('components/empty_state', {
            colspan: 5,
            message: 'Belum ada data santri untuk lembaga ini. Silakan tarik data dari SPMB terlebih dahulu.'
          }) %>
        <% } else { %>
          <% santriList.forEach((santri, index) => { %>
            <tr class="hover:bg-slate-50/70 transition duration-150">
              <td class="p-4 pl-6 text-center text-slate-400 font-semibold"><%= index + 1 %></td>
              <td class="p-4 font-semibold text-slate-800"><%= santri.nama %></td>
              <td class="p-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-800">
                  <%= santri.kelas ? santri.kelas.nama : 'Tidak Ada Kelas' %>
                </span>
              </td>
              <td class="p-4 text-slate-500"><%= santri.lembaga ? santri.lembaga.nama : lembaga.nama %></td>
              <td class="p-4 text-center flex items-center justify-center gap-2">
                <a href="/santri/edit/<%= santri.id %>" class="text-indigo-500 hover:text-indigo-700 p-1.5 rounded-lg hover:bg-indigo-50 transition duration-150" title="Edit Santri">
                  <i class="bi bi-pencil-fill"></i>
                </a>
                <form action="/santri/delete/<%= santri.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data santri ini?');" class="inline">
                  <button type="submit" class="text-rose-500 hover:text-rose-700 p-1.5 rounded-lg hover:bg-rose-50 transition duration-150" title="Hapus Santri">
                    <i class="bi bi-trash3-fill"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <% 
      let queryStr = '';
      if (typeof queryParams !== 'undefined') {
        Object.keys(queryParams).forEach(key => {
          if (key !== 'page' && key !== 'success' && key !== 'error') {
            queryStr += `&${key}=${encodeURIComponent(queryParams[key])}`;
          }
        });
      }
  %>
  <%- include('components/pagination', { currentPage, totalPages, totalItems, limit, queryStr }) %>
</div>

<script src="/js/table-filter.js"></script>
<%- include('partials/footer') %>
