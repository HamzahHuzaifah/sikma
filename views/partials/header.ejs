<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIKMA - Sistem Informasi Keuangan Madrasah</title>
  <!-- Favicon -->
  <link rel="icon" type="image/webp" href="/images/logo-madrasah.webp">
  <!-- Tailwind CSS v3 CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Tailwind CSS Config -->
  <script src="/js/tailwind-config.js"></script>
  <!-- Google Fonts - Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Bootstrap Icons (Untuk Icon yang konsisten & bersih) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  
  <!-- jQuery & Select2 -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

  <!-- Flatpickr CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  
  <!-- Custom CSS (Select2, Flatpickr, Scrollbar overrides) -->
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="bg-slate-50 print:bg-white text-slate-800 min-h-screen flex flex-col font-sans">

  <!-- Global Loader Spinner -->
  <div id="global-loader" class="fixed inset-0 bg-slate-900/30 backdrop-blur-sm z-[9999] flex items-center justify-center hidden opacity-0 transition-opacity duration-300 print:hidden">
    <div class="bg-white/90 backdrop-blur border border-slate-100 rounded-2xl p-6 shadow-2xl flex flex-col items-center gap-4 max-w-xs text-center">
      <div class="relative w-12 h-12">
        <div class="absolute inset-0 rounded-full border-4 border-slate-100 border-t-brand-500 animate-spin"></div>
      </div>
      <div>
        <h3 class="font-bold text-slate-800 text-sm">Memproses...</h3>
        <p class="text-xs text-slate-500 mt-1">Mohon tunggu sebentar, sedang memuat data.</p>
      </div>
    </div>
  </div>

  <!-- Top Navbar -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-40 print:hidden">
    <div class="w-full mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16 items-center">
        <!-- Logo -->
        <a class="flex items-center gap-2" href="/admin">
          <div class="bg-brand-500 text-white p-2 rounded-lg flex items-center justify-center shadow-md">
            <i class="bi bi-wallet2 text-lg"></i>
          </div>
          <div>
            <span class="font-bold text-xl tracking-tight text-brand-600">SIKMA</span>
            <span class="hidden sm:inline text-xs text-slate-400 font-semibold border-l border-slate-200 pl-2 ml-2">Keuangan Madrasah</span>
          </div>
        </a>
        
        <!-- Online Users (Realtime) -->
        <div class="hidden sm:flex items-center gap-2 mr-4" id="onlineUsersWrapper" style="display: none;">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Online</span>
          <div class="flex -space-x-2" id="onlineUsersList">
            <!-- Avatars will be injected here -->
          </div>
        </div>

        <!-- User Profile Dropdown -->
        <div class="relative flex items-center" id="profileDropdown">
          <button onclick="toggleDropdown()" class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 pl-2 pr-4 py-1.5 rounded-full font-semibold text-sm text-slate-600 transition shadow-sm">
            <% 
              const name = locals.user ? locals.user.nama_lengkap : (locals.username || 'Admin');
              const username = locals.user ? locals.user.username : 'admin';
              const initial = name.charAt(0).toUpperCase();
              
              // Backend color hash identical to frontend
              let hash = 0;
              for (let i = 0; i < username.length; i++) {
                  hash = username.charCodeAt(i) + ((hash << 5) - hash);
              }
              const colors = ['#e11d48', '#2563eb', '#059669', '#d97706', '#7c3aed', '#db2777', '#0891b2', '#ea580c'];
              const color = colors[Math.abs(hash) % colors.length];
            %>
            <div class="w-7 h-7 rounded-full flex items-center justify-center text-white text-[11px] font-bold" style="background-color: <%= color %>">
              <%= initial %>
            </div>
            <span><%= name %></span>
            <i class="bi bi-chevron-down text-xs ml-1 text-slate-400"></i>
          </button>
          <!-- Dropdown Menu -->
          <div id="dropdownMenu" class="hidden absolute right-0 mt-2 w-48 bg-white border border-slate-100 rounded-xl shadow-lg py-1 z-50">
            <a class="flex items-center gap-2 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 hover:text-brand-600 font-medium transition" href="/super-admin/users">
              <i class="bi bi-person-badge"></i> Kelola Pengguna
            </a>
            <hr class="border-slate-100 my-1">
            <a class="flex items-center gap-2 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 font-semibold transition" href="/logout">
              <i class="bi bi-box-arrow-right"></i> Keluar
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <script src="/js/header.js"></script>

  <script src="/js/admin-online.js"></script>

  <!-- Container Wrapper -->
  <div class="w-full mx-auto flex-grow flex flex-col md:flex-row px-4 sm:px-6 lg:px-8 py-6 gap-6">
