<%- include('partials/header', { title: 'Edit Santri' }) %>
<%- include('partials/sidebar') %>

<%- include('components/page_header', { 
  title: 'Edit Data Santri', 
  subtitle: 'Ubah informasi data santri, kelas, dan lembaga terkait.'
}) %>

<div class="max-w-2xl mx-auto">
  <!-- Main Card -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 md:p-8">
    <h2 class="text-lg font-bold text-slate-800 mb-6 flex items-center gap-2 border-b border-slate-100 pb-4">
      <i class="bi bi-pencil-square text-indigo-500"></i> Form Edit Santri
    </h2>

    <form action="/admin/santri/edit/<%= santri.id %>" method="POST" class="space-y-6">
      
      <%- include('components/input_field', {
        id: 'nama',
        label: 'Nama Santri',
        name: 'nama',
        value: santri.nama,
        required: true,
        placeholder: 'Nama Lengkap Santri'
      }) %>

      <!-- Satuan Pendidikan / Lembaga -->
      <%- include('components/select_field', {
        id: 'lembagaId',
        label: 'Satuan Pendidikan / Lembaga',
        name: 'lembagaId',
        required: true,
        options: lembagas,
        selectedId: santri.lembagaId,
        onChange: 'handleLembagaChange(this.value)'
      }) %>

      <!-- Kelas -->
      <%- include('components/select_field', {
        id: 'kelasId',
        label: 'Kelas (Opsional)',
        name: 'kelasId',
        required: false,
        placeholder: '-- Tanpa Kelas --',
        options: kelasList,
        selectedId: santri.kelasId
      }) %>

      <%- include('components/form_actions', {
        backUrl: '/admin/lembaga/mjic/santri',
        submitText: 'Simpan Perubahan'
      }) %>

<script src="/js/santri-edit.js"></script>

<%- include('partials/footer') %>
