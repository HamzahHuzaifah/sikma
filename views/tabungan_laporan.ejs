<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="w-full mx-auto pb-10">

<%- include('components/page_header', { 
  title: 'Laporan & Rekapitulasi Tabungan Santri', 
  subtitle: 'Lihat histori setoran dan penarikan tabungan santri, serta rekap saldo.',
  actionHtml: ''
}) %>

<!-- Filter Horizontal (SPMB Style) -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-4 mb-6">
  <form action="/admin/tabungan" method="GET" id="filterForm" class="flex flex-wrap items-center gap-3 w-full">
    
    <div class="flex-grow min-w-[200px]">
      <div class="relative">
        <input 
          type="text" 
          name="search" 
          value="<%= typeof search !== 'undefined' ? search : '' %>" 
          placeholder="Cari santri/keterangan..." 
          class="w-full pl-10 pr-4 py-2.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all"
        >
        <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
      </div>
    </div>

    <div class="w-full md:w-32 shrink-0">
      <input 
        type="number" 
        name="tahun" 
        value="<%= typeof queryParams !== 'undefined' && queryParams.tahun ? queryParams.tahun : new Date().getFullYear() %>" 
        placeholder="Tahun"
        min="2000"
        max="2100"
        class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none transition"
      >
    </div>

    <div class="w-full md:w-auto">
      <select 
        name="bulan" 
        class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none transition cursor-pointer"
      >
        <option value="">Semua Bulan</option>
        <option value="1" <%= (typeof queryParams !== 'undefined' && queryParams.bulan == '1') ? 'selected' : '' %>>Januari</option>
        <option value="2" <%= (typeof queryParams !== 'undefined' && queryParams.bulan == '2') ? 'selected' : '' %>>Februari</option>
        <option value="3" <%= (typeof queryParams !== 'undefined' && queryParams.bulan == '3') ? 'selected' : '' %>>Maret</option>
        <option value="4" <%= (typeof queryParams !== 'undefined' && queryParams.bulan == '4') ? 'selected' : '' %>>April</option>
        <option value="5" <%= (typeof queryParams !== 'undefined' && queryParams.bulan == '5') ? 'selected' : '' %>>Mei</option>
        <option value="6" <%= (typeof queryParams !== 'undefined' && queryParams.bulan == '6') ? 'selected' : '' %>>Juni</option>
        <option value="7" <%= (typeof queryParams !== 'undefined' && queryParams.bulan == '7') ? 'selected' : '' %>>Juli</option>
        <option value="8" <%= (typeof queryParams !== 'undefined' && queryParams.bulan == '8') ? 'selected' : '' %>>Agustus</option>
        <option value="9" <%= (typeof queryParams !== 'undefined' && queryParams.bulan == '9') ? 'selected' : '' %>>September</option>
        <option value="10" <%= (typeof queryParams !== 'undefined' && queryParams.bulan == '10') ? 'selected' : '' %>>Oktober</option>
        <option value="11" <%= (typeof queryParams !== 'undefined' && queryParams.bulan == '11') ? 'selected' : '' %>>November</option>
        <option value="12" <%= (typeof queryParams !== 'undefined' && queryParams.bulan == '12') ? 'selected' : '' %>>Desember</option>
      </select>
    </div>

    <div class="w-full md:w-auto">
      <select 
        name="lembagaId" 
        class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none transition cursor-pointer"
        onchange="loadKelasFilter(this.value)"
      >
        <option value="">Semua Lembaga</option>
        <% lembagas.forEach(lem => { %>
          <option value="<%= lem.id %>" <%= filters.lembagaId == lem.id ? 'selected' : '' %>><%= lem.nama %></option>
        <% }) %>
      </select>
    </div>

    <div class="w-full md:w-auto">
      <select 
        id="kelasId" 
        name="kelasId" 
        data-selected-kelas="<%= typeof filters !== 'undefined' && filters.kelasId ? filters.kelasId : '' %>"
        class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none transition cursor-pointer"
        onchange="loadSantriFilter(this.value)"
      >
        <option value="">Semua Kelas</option>
      </select>
    </div>

    <div class="w-full md:w-auto">
      <select 
        id="santriId" 
        name="santriId" 
        data-selected-santri="<%= typeof filters !== 'undefined' && filters.santriId ? filters.santriId : '' %>"
        class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none transition cursor-pointer"
      >
        <option value="">Semua Santri</option>
      </select>
    </div>

    <div class="flex gap-2 w-full md:w-auto shrink-0 mt-2 md:mt-0 ml-auto">
      <button type="submit" class="bg-brand-500 hover:bg-brand-600 text-white font-bold py-2.5 px-5 rounded-xl shadow-md hover:shadow-brand-500/10 active:scale-[0.98] transition text-sm">
        Filter
      </button>
      <a href="/admin/tabungan" class="bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-500 font-bold p-2.5 px-4 rounded-xl transition text-sm flex items-center justify-center">
        Reset
      </a>
      <button 
        type="button" 
        onclick="checkPreviewLaporan('/admin/tabungan/cetak')"
        class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold py-2.5 px-4 rounded-xl border border-indigo-200 transition text-sm flex items-center gap-1.5"
      >
        <i class="bi bi-printer-fill"></i> Preview Laporan
      </button>
    </div>
  </form>
</div>

<!-- Tabel Laporan (SPMB Style) -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-6">
  <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <i class="bi bi-journal-text text-indigo-500 text-lg"></i>
      <h3 class="font-bold text-slate-700">Buku Tabungan</h3>
    </div>
  </div>
  
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-100 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
          <th class="p-4 pl-6 w-16 text-center">No</th>
          <th class="p-4">Tanggal</th>
          <th class="p-4">No. Transaksi</th>
          <th class="p-4">Lembaga</th>
          <th class="p-4 max-w-[300px]">Uraian</th>
          <th class="p-4">Operator</th>
          <th class="p-4 text-right">Setor (Masuk)</th>
          <th class="p-4 text-right">Tarik (Keluar)</th>
          <th class="p-4 pr-6 text-right font-extrabold text-slate-600">Saldo Akhir</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 text-sm text-slate-600 font-medium">
        
        <!-- Saldo Awal Row -->
        <tr class="bg-slate-50/50">
            <td class="p-4 pl-6 text-center text-xs">-</td>
            <td class="p-4 text-xs font-mono"><%= filters.startDate ? new Date(filters.startDate).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '-' %></td>
            <td class="p-4 text-xs font-mono text-slate-400">-</td>
            <td class="p-4 text-xs text-slate-400">-</td>
            <td class="p-4 text-slate-500 font-semibold text-xs italic">Saldo Tabungan Sebelumnya</td>
            <td class="p-4 text-xs text-slate-400">-</td>
            <td class="p-4 text-right font-bold text-emerald-500"><%= saldoAwal > 0 ? new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(saldoAwal) : '-' %></td>
            <td class="p-4 text-right font-bold text-rose-500"><%= saldoAwal < 0 ? new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(Math.abs(saldoAwal)) : '-' %></td>
            <td class="p-4 pr-6 text-right font-extrabold text-slate-700 bg-slate-100/50">
                <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(saldoAwal) %>
            </td>
        </tr>

        <% if (tabunganList.length === 0) { %>
          <%- include('components/empty_state', {
            colspan: 9,
            message: 'Belum ada mutasi tabungan.'
          }) %>
        <% } %>

        <% 
          let currentIndex = (currentPage - 1) * limit;
          tabunganList.forEach((group, groupIndex) => { 
        %>
          <% if (group.items.length === 1) { %>
            <% const t = group.items[0]; currentIndex++; %>
            <tr class="hover:bg-slate-50/50 transition">
                <td class="p-4 pl-6 text-center text-slate-400 font-semibold"><%= currentIndex %></td>
                <td class="p-4 text-xs font-mono"><%= new Date(t.tanggal).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) %></td>
                <td class="p-4 text-xs font-mono text-slate-500"><%= t.nomor_kwitansi || '-' %></td>
                <td class="p-4 font-semibold text-slate-800"><%= t.lembaga ? t.lembaga.nama : '-' %></td>
                <td class="p-4 text-slate-500 font-medium text-xs max-w-xs truncate" title="[Santri: <%= t.santri ? t.santri.nama : '-' %>] [Kelas: <%= t.kelas ? t.kelas.nama : 'Umum' %>] <%= t.keterangan || '' %>">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold tracking-wider bg-brand-100 text-brand-600 mr-1"><%= t.kelas ? t.kelas.nama : 'Umum' %></span>
                  <span class="font-bold text-slate-700"><%= t.santri ? t.santri.nama : '-' %></span> - <%= t.keterangan || '-' %>
                </td>
                <td class="p-4 text-xs font-medium text-slate-500"><%= t.user ? t.user.nama_lengkap : 'Sistem' %></td>
                <td class="p-4 text-right font-bold text-emerald-500"><%= t.tipe === 'Setor' ? new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(t.nominal) : '-' %></td>
                <td class="p-4 text-right font-bold text-rose-500"><%= t.tipe === 'Tarik' ? new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(t.nominal) : '-' %></td>
                <td class="p-4 pr-6 text-right font-extrabold text-slate-700 bg-slate-50">
                    <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(t.saldoAkhir) %>
                </td>
            </tr>
            <!-- Row Actions for single item -->
            <tr class="bg-slate-50/20 border-b border-slate-100/50">
               <td colspan="5"></td>
               <td colspan="4" class="p-2 pr-6 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <span class="text-[10px] text-slate-400 font-semibold mr-2 uppercase tracking-wider">Aksi Transaksi:</span>
                    <% 
                      const getSlug = (lembagaName) => {
                        const name = lembagaName.toLowerCase();
                        if (name.includes('madrasah')) return 'mjic';
                        if (name.includes('paudqu')) return 'paudqu';
                        if (name.includes('tpq')) return 'tpq';
                        if (name.includes('mdt')) return 'mdt';
                        return 'mjic';
                      };
                    %>
                    <button type="button" onclick="toggleKwitansiPreview(this, '/admin/lembaga/<%= getSlug(t.lembaga ? t.lembaga.nama : 'Madrasah') %>/tabungan-kwitansi/<%= t.id %>?preview=1', 9)" class="text-indigo-500 hover:text-indigo-700 p-1 bg-indigo-50 rounded" title="Preview Kwitansi">
                        <i class="bi bi-printer-fill text-xs"></i>
                    </button>
                    <form action="/admin/tabungan/delete/<%= t.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus transaksi ini?');" class="inline m-0 p-0">
                      <input type="hidden" name="redirectUrl" value="/admin/tabungan">
                      <button type="submit" class="text-rose-500 hover:text-rose-700 p-1 bg-rose-50 rounded" title="Hapus Transaksi">
                        <i class="bi bi-trash3-fill text-xs"></i>
                      </button>
                    </form>
                  </div>
               </td>
            </tr>
          <% } else { %>
            <% currentIndex++; %>
            <tr class="hover:bg-slate-50/50 transition cursor-pointer" onclick="document.getElementById('group-<%= groupIndex %>').classList.toggle('hidden')">
                <td class="p-4 pl-6 text-center text-slate-400 font-semibold"><%= currentIndex %> <i class="bi bi-chevron-down text-[10px] ml-1 text-brand-500"></i></td>
                <td class="p-4 text-xs font-mono"><%= new Date(group.tanggal).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) %></td>
                <td class="p-4 text-xs font-mono text-brand-600 font-semibold">Mutasi Massal</td>
                <td class="p-4 font-semibold text-slate-800"><%= group.lembaga ? group.lembaga.nama : '-' %></td>
                <td class="p-4 text-slate-500 font-medium text-xs max-w-xs truncate">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold tracking-wider bg-brand-100 text-brand-600 mr-1"><%= group.kelas ? group.kelas.nama : 'Umum' %></span>
                  <%= group.tipe %> Tabungan Massal (<%= group.items.length %> Santri)
                </td>
                <td class="p-4 text-xs font-medium text-slate-500"><%= group.items[0].user ? group.items[0].user.nama_lengkap : 'Sistem' %></td>
                <td class="p-4 text-right font-bold text-emerald-500"><%= group.tipe === 'Setor' ? new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(group.totalNominal) : '-' %></td>
                <td class="p-4 text-right font-bold text-rose-500"><%= group.tipe === 'Tarik' ? new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(group.totalNominal) : '-' %></td>
                <td class="p-4 pr-6 text-right font-extrabold text-slate-700 bg-slate-50">
                    <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(group.saldoAkhir) %>
                </td>
            </tr>
            <tr id="group-<%= groupIndex %>" class="hidden bg-slate-50/50 border-y border-slate-200">
               <td colspan="9" class="p-0">
                  <div class="p-4 bg-white shadow-inner">
                    <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3"><i class="bi bi-list-ul mr-1"></i> Rincian Transaksi Massal</h4>
                    <table class="w-full text-left text-xs">
                       <thead class="text-slate-400 border-b border-slate-100">
                         <tr>
                           <th class="py-2 pl-4 w-10 text-center">No</th>
                           <th class="py-2">No. Kwitansi</th>
                           <th class="py-2">Nama Santri</th>
                           <th class="py-2">Keterangan</th>
                           <th class="py-2">Operator</th>
                           <th class="py-2 text-right">Nominal</th>
                           <th class="py-2 text-center w-24">Aksi</th>
                         </tr>
                       </thead>
                       <tbody class="divide-y divide-slate-50 text-slate-600">
                         <% 
                           const getSlug = (lembagaName) => {
                             const name = lembagaName.toLowerCase();
                             if (name.includes('madrasah')) return 'mjic';
                             if (name.includes('paudqu')) return 'paudqu';
                             if (name.includes('tpq')) return 'tpq';
                             if (name.includes('mdt')) return 'mdt';
                             return 'mjic';
                           };
                           group.items.forEach((t, i) => { 
                         %>
                           <tr class="hover:bg-slate-50 transition">
                             <td class="py-2 pl-4 text-center"><%= i + 1 %></td>
                             <td class="py-2 font-mono text-slate-500"><%= t.nomor_kwitansi || '-' %></td>
                             <td class="py-2 font-semibold text-slate-700"><%= t.santri ? t.santri.nama : '-' %></td>
                             <td class="py-2 max-w-[200px] truncate"><%= t.keterangan || '-' %></td>
                             <td class="py-2 font-medium text-slate-500"><%= t.user ? t.user.nama_lengkap : 'Sistem' %></td>
                             <td class="py-2 text-right font-bold <%= group.tipe === 'Setor' ? 'text-emerald-500' : 'text-rose-500' %>"><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(t.nominal) %></td>
                             <td class="py-2 text-center">
                               <button type="button" onclick="toggleKwitansiPreview(this, '/admin/lembaga/<%= getSlug(t.lembaga ? t.lembaga.nama : 'Madrasah') %>/tabungan-kwitansi/<%= t.id %>?preview=1', 9)" class="text-indigo-500 hover:text-indigo-700 p-1 bg-indigo-50 rounded" title="Preview Kwitansi">
                                   <i class="bi bi-printer-fill text-xs"></i>
                               </button>
                               <form action="/admin/tabungan/delete/<%= t.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus transaksi ini?');" class="inline m-0 p-0">
                                 <input type="hidden" name="redirectUrl" value="/admin/tabungan">
                                 <button type="submit" class="text-rose-500 hover:text-rose-700 p-1 bg-rose-50 rounded" title="Hapus Transaksi">
                                   <i class="bi bi-trash3-fill text-[10px]"></i>
                                 </button>
                               </form>
                             </td>
                           </tr>
                         <% }) %>
                       </tbody>
                    </table>
                  </div>
               </td>
            </tr>
          <% } %>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% 
      let queryStr = '';
      if (typeof queryParams !== 'undefined') {
        Object.keys(queryParams).forEach(key => {
          if (key !== 'page' && key !== 'success' && key !== 'error') {
            queryStr += `&${key}=${encodeURIComponent(queryParams[key])}`;
          }
        });
      }
  %>
  <%- include('components/pagination', { currentPage, totalPages, totalItems, limit, queryStr }) %>
</div>

</div>

<%- include('components/laporan_modal') %>

<script src="/js/filter-kelas.js"></script>

<script src="/js/preview_kwitansi.js"></script>
<%- include('partials/footer') %>
