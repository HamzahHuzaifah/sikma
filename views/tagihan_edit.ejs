<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<%- include('components/page_header', { 
  title: 'Edit Aturan Tagihan', 
  subtitle: 'Ubah aturan master tagihan santri dan lembaga terkait.'
}) %>

<div class="max-w-2xl mx-auto">
  <!-- Main Card -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 md:p-8">
    <h2 class="text-lg font-bold text-slate-800 mb-6 flex items-center gap-2 border-b border-slate-100 pb-4">
      <i class="bi bi-pencil-square text-indigo-500"></i> Form Edit Tagihan
    </h2>

    <form action="/admin/tagihan/edit/<%= tagihan.id %>" method="POST" class="space-y-6">
      
      <%- include('components/input_field', {
        id: 'nama',
        label: 'Nama Tagihan',
        name: 'nama',
        value: tagihan.nama,
        required: true,
        placeholder: 'Contoh: SPP, Uang Pendaftaran'
      }) %>

      <%- include('components/input_field', {
        id: 'nominal',
        label: 'Nominal (Rp)',
        name: 'nominal',
        type: 'number',
        value: Math.floor(tagihan.nominal),
        required: true,
        placeholder: 'Nilai Uang Tagihan'
      }) %>

      <%- include('components/select_field', {
        id: 'lembagaId',
        label: 'Satuan Pendidikan / Lembaga',
        name: 'lembagaId',
        required: true,
        options: lembagas,
        selectedId: tagihan.lembagaId
      }) %>

      <!-- Keterangan -->
      <div>
        <label for="keterangan" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Keterangan (Opsional)</label>
        <textarea 
          id="keterangan" 
          name="keterangan" 
          rows="3"
          class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition duration-150"
          placeholder="Keterangan singkat mengenai tagihan ini..."
        ><%= tagihan.keterangan || '' %></textarea>
      </div>

      <%- include('components/form_actions', {
        backUrl: '/admin/tagihan',
        submitText: 'Simpan Perubahan'
      }) %>
      
    </form>
  </div>
</div>

<%- include('partials/footer') %>
