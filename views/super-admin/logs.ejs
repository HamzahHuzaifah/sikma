<%- include('../partials/header', { title: 'Log Aktivitas Sistem' }) %>
<%- include('../partials/super-admin-sidebar') %>

<div class="w-full">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-800">Pantauan Log Aktivitas</h1>
    <p class="text-sm text-slate-500 mt-1">Lacak dan pantau aktivitas seluruh pengguna sistem secara real-time.</p>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
    <div class="p-6 overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[800px]">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="py-3 px-4 font-semibold text-sm text-slate-700">Waktu</th>
            <th class="py-3 px-4 font-semibold text-sm text-slate-700">Pengguna</th>
            <th class="py-3 px-4 font-semibold text-sm text-slate-700">Modul</th>
            <th class="py-3 px-4 font-semibold text-sm text-slate-700">Aktivitas</th>
            <th class="py-3 px-4 font-semibold text-sm text-slate-700 w-16 text-center">Aksi</th>
          </tr>
        </thead>
        <tbody id="logsTableBody" class="divide-y divide-slate-100">
          <tr>
            <td colspan="5" class="py-8 text-center text-slate-500">Memuat log aktivitas...</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Pagination Controls -->
    <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
      <div class="text-sm text-slate-500">
        Menampilkan halaman <span id="currentPageText" class="font-semibold text-slate-700">1</span> dari <span id="totalPagesText" class="font-semibold text-slate-700">1</span>
        (Total <span id="totalItemsText" class="font-semibold text-slate-700">0</span> log)
      </div>
      <div class="flex items-center gap-2">
        <button id="btnPrev" onclick="changePage(-1)" disabled class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition">
          <i class="bi bi-chevron-left mr-1"></i> Prev
        </button>
        <button id="btnNext" onclick="changePage(1)" disabled class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition">
          Next <i class="bi bi-chevron-right ml-1"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let currentPage = 1;
  const limit = 15;

  async function fetchLogs() {
    try {
      const response = await fetch(`/admin/api/log-history?page=${currentPage}&limit=${limit}`);
      const result = await response.json();

      const tbody = document.getElementById('logsTableBody');
      tbody.innerHTML = '';

      if (result.data && result.data.length > 0) {
        result.data.forEach(log => {
          const date = new Date(log.createdAt);
          const formattedDate = date.toLocaleString('id-ID', {
            day: '2-digit', month: 'short', year: 'numeric',
            hour: '2-digit', minute: '2-digit'
          });

          const userName = log.user ? log.user.nama_lengkap : 'Sistem / Anonim';
          
          let badgeClass = 'bg-slate-100 text-slate-700';
          if (log.aksi === 'HAPUS') badgeClass = 'bg-red-100 text-red-700';
          if (log.aksi === 'EDIT') badgeClass = 'bg-amber-100 text-amber-700';
          if (log.aksi === 'INPUT') badgeClass = 'bg-green-100 text-green-700';

          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-50 transition group';
          tr.innerHTML = `
            <td class="py-3 px-4 text-sm text-slate-500 align-top whitespace-nowrap">${formattedDate}</td>
            <td class="py-3 px-4 text-sm text-slate-700 font-medium align-top">${userName}</td>
            <td class="py-3 px-4 align-top">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${badgeClass}">
                ${log.aksi} ${log.modul}
              </span>
            </td>
            <td class="py-3 px-4 text-sm text-slate-600 align-top">${log.keterangan || '-'}</td>
            <td class="py-3 px-4 text-center align-top">
              <button onclick="deleteLog('${log.id}')" class="text-slate-400 hover:text-red-500 opacity-0 group-hover:opacity-100 transition" title="Hapus Log">
                <i class="bi bi-trash"></i>
              </button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      } else {
        tbody.innerHTML = '<tr><td colspan="5" class="py-8 text-center text-slate-500">Belum ada riwayat aktivitas.</td></tr>';
      }

      // Update Pagination
      document.getElementById('currentPageText').textContent = result.currentPage;
      document.getElementById('totalPagesText').textContent = result.totalPages || 1;
      document.getElementById('totalItemsText').textContent = result.totalItems;

      document.getElementById('btnPrev').disabled = result.currentPage <= 1;
      document.getElementById('btnNext').disabled = result.currentPage >= result.totalPages;

    } catch (error) {
      console.error('Failed to fetch logs:', error);
      document.getElementById('logsTableBody').innerHTML = '<tr><td colspan="5" class="py-8 text-center text-red-500">Gagal memuat data log.</td></tr>';
    }
  }

  function changePage(delta) {
    currentPage += delta;
    fetchLogs();
  }

  async function deleteLog(id) {
    if (confirm('Yakin ingin menghapus riwayat aktivitas ini secara permanen?|Ya, Hapus!')) {
      try {
        const response = await fetch(`/admin/api/log-history/${id}`, {
          method: 'DELETE'
        });
        const result = await response.json();
        
        if (result.success) {
          fetchLogs(); // Reload data
        } else {
          alert('Gagal: ' + result.message);
        }
      } catch (error) {
        alert('Terjadi kesalahan saat menghapus log.');
      }
    }
  }

  // Load first page on ready
  document.addEventListener('DOMContentLoaded', fetchLogs);
</script>

<%- include('../partials/footer') %>
