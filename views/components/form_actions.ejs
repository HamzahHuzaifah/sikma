<%
  const backUrl = locals.backUrl || '/';
  const submitText = locals.submitText || 'Simpan';
  const disabled = locals.disabled ? 'disabled' : '';
%>
<div class="flex items-center justify-end gap-4 border-t border-slate-100 pt-6">
  <a href="<%= backUrl %>" class="px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-500 hover:text-slate-700 bg-slate-100 hover:bg-slate-200 transition duration-150">Batal</a>
  <button type="submit" <%= disabled %> class="px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:ring-4 focus:ring-indigo-500/20 transition duration-150 shadow-md disabled:bg-indigo-400 disabled:cursor-not-allowed"><%= submitText %></button>
</div>
