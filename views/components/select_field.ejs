<% 
  const id = locals.id || '';
  const label = locals.label || '';
  const name = locals.name || '';
  const options = locals.options || [];
  const placeholder = locals.placeholder || 'Pilih Opsi...';
  const required = locals.required ? 'required' : '';
  const disabled = locals.disabled ? 'disabled' : '';
  const onChange = locals.onChange ? `onchange="${locals.onChange}"` : '';
  const optionsHTML = locals.optionsHTML || '';
  const customClass = locals.customClass || '';
  const idAttr = id ? `id="${id}"` : '';
%>
<div class="mb-4">
  <label for="<%= id %>" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
    <%= label %> <%= locals.required ? '*' : '' %>
  </label>
  <select 
    class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none transition duration-150 disabled:bg-slate-50 disabled:text-slate-400 disabled:cursor-not-allowed cursor-pointer <%= customClass %>" 
    <%- idAttr %> 
    name="<%= name %>" 
    <%= required %> 
    <%= disabled %> 
    <%- onChange %>
  >
    <% if (placeholder) { %>
      <option value="" disabled <%= !locals.selectedId ? 'selected' : '' %>><%= placeholder %></option>
    <% } %>
    
    <% if (optionsHTML) { %>
      <%- optionsHTML %>
    <% } else { %>
      <% options.forEach(opt => { %>
        <option value="<%= opt.id %>" <%= locals.selectedId && String(locals.selectedId) === String(opt.id) ? 'selected' : '' %>><%= opt.nama || opt.label %></option>
      <% }) %>
    <% } %>
  </select>
</div>
