<% 
  const title = locals.title || 'Summary';
  const amount = locals.amount || 0;
  const bgColor = locals.bgColor || '';
  const icon = locals.icon || 'bi-wallet2';
  
  // Format currency helper
  const formatIDR = (val) => {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0
    }).format(val);
  };

  // Map Bootstrap gradients to Tailwind CSS gradients
  let bgTailwind = 'from-indigo-500 to-brand-600'; // Default
  if (bgColor.includes('success')) {
    bgTailwind = 'from-emerald-500 to-teal-600';
  } else if (bgColor.includes('danger')) {
    bgTailwind = 'from-rose-500 to-red-600';
  } else if (bgColor.includes('primary')) {
    bgTailwind = 'from-indigo-500 to-brand-600';
  }
%>
<div class="bg-gradient-to-br <%= bgTailwind %> rounded-2xl p-6 text-white shadow-md flex justify-between items-center transition hover:shadow-lg duration-200">
  <div>
    <span class="text-xs uppercase font-bold tracking-wider opacity-75 block mb-1"><%= title %></span>
    <h3 class="text-2xl font-extrabold tracking-tight"><%= formatIDR(amount) %></h3>
  </div>
  <div class="text-3xl opacity-50 bg-white/10 p-3.5 rounded-xl flex items-center justify-center">
    <i class="bi <%= icon %>"></i>
  </div>
</div>
