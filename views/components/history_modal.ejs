<!-- History Modal -->
<div id="historyModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9999] hidden flex justify-center opacity-0 transition-opacity duration-300 print:hidden items-start pt-10 px-4">
  <div class="bg-white rounded-2xl w-full max-w-3xl max-h-[85vh] flex flex-col shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300" id="historyModalContent">
    
    <!-- Modal Header -->
    <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
      <div>
        <h3 class="font-bold text-lg text-slate-800 flex items-center gap-2">
          <i class="bi bi-clock-history text-brand-600"></i> Riwayat Aktivitas Admin
        </h3>
        <p class="text-xs text-slate-500 mt-1">Menampilkan riwayat aktivitas yang dilakukan di SIKMA.</p>
      </div>
      <button onclick="closeHistoryModal()" class="text-slate-400 hover:text-rose-500 transition focus:outline-none p-1 rounded-lg hover:bg-rose-50">
        <i class="bi bi-x-lg text-xl"></i>
      </button>
    </div>

    <!-- Modal Body (Scrollable) -->
    <div class="p-0 flex flex-col flex-1 relative bg-slate-50/30 overflow-hidden" id="historyLogContainer">
      <div class="overflow-y-auto flex-1 p-0">
        <!-- Loading State -->
        <div id="historyLoading" class="flex flex-col items-center justify-center py-12">
          <div class="relative w-10 h-10 mb-4">
            <div class="absolute inset-0 rounded-full border-4 border-slate-200 border-t-brand-500 animate-spin"></div>
          </div>
          <span class="text-sm text-slate-500 font-medium">Memuat riwayat...</span>
        </div>

        <!-- Logs List -->
        <ul id="historyList" class="hidden divide-y divide-slate-100">
          <!-- Log items will be injected here via AJAX -->
        </ul>

        <!-- Empty State -->
        <div id="historyEmpty" class="hidden flex flex-col items-center justify-center py-16 px-6 text-center">
          <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mb-4">
            <i class="bi bi-inbox text-3xl"></i>
          </div>
          <h4 class="font-bold text-slate-700">Belum ada aktivitas</h4>
          <p class="text-sm text-slate-500 mt-1">Riwayat aktivitas admin akan muncul di sini.</p>
        </div>
      </div>
      
      <!-- Pagination Footer -->
      <div id="historyPagination" class="hidden p-4 border-t border-slate-100 bg-white flex items-center justify-between">
        <span class="text-xs text-slate-500 font-medium" id="historyPageInfo">Halaman 1 dari 1</span>
        <div class="flex gap-2">
          <button id="historyPrevBtn" class="px-3 py-1.5 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-md transition disabled:opacity-50 disabled:cursor-not-allowed">
            <i class="bi bi-chevron-left"></i> Prev
          </button>
          <button id="historyNextBtn" class="px-3 py-1.5 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-md transition disabled:opacity-50 disabled:cursor-not-allowed">
            Next <i class="bi bi-chevron-right"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.IS_SUPER_ADMIN = <%= (locals.user && locals.user.role === 'Super Admin') ? 'true' : 'false' %>;
</script>
<script src="/js/history-modal.js"></script>
