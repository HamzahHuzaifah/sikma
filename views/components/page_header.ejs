<%
  const title = locals.title || '';
  const subtitle = locals.subtitle || '';
  const actionHtml = locals.actionHtml || '';
%>
<div class="border-b border-slate-100 pb-5 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
  <div>
    <h1 class="text-2xl font-extrabold text-slate-800 tracking-tight"><%= title %></h1>
    <% if (subtitle) { %>
      <p class="text-sm text-slate-400 font-medium mt-1"><%= subtitle %></p>
    <% } %>
  </div>
  <% if (actionHtml) { %>
    <div class="flex gap-3">
      <%- actionHtml %>
    </div>
  <% } %>
</div>
